#version 450
#extension GL_GOOGLE_include_directive : require
#include "fog_transport.glsl"
layout(local_size_x=1) in;
layout(binding=0) uniform sampler3D fogVolume;
layout(std430,binding=1) readonly buffer Inputs { vec4 positions[]; };
layout(std430,binding=2) writeonly buffer Outputs { vec4 results[]; };
void main() {
    uint i=gl_GlobalInvocationID.x;
    vec4 sampleValue=textureLod(fogVolume,positions[i].xyz,0);
    AzureFogTransport fog=azureFogVolumeTransport(sampleValue);
    results[i*3]=sampleValue;
    results[i*3+1]=vec4(azureApplyFogTransport(fog,vec3(1,2,3),1),1);
    results[i*3+2]=vec4(azureApplyFogTransport(fog,vec3(1,2,3),0),1);
}

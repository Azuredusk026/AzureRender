#version 450
#extension GL_GOOGLE_include_directive : require
#include "fog_transport.glsl"
#include "fog_view_projection.glsl"
layout(local_size_x=1) in;
layout(binding=0) uniform sampler3D fogVolume;
layout(std430,binding=1) readonly buffer Inputs { vec4 positions[]; };
layout(std430,binding=2) writeonly buffer Outputs { vec4 results[]; };
layout(std430,binding=3) readonly buffer Projection { vec4 fogProjectionRows[3]; };
void main() {
    uint i=gl_GlobalInvocationID.x;
    vec4 coordinates=positions[i].w>.5?azureFogViewCoordinates(fogProjectionRows,uvec2(positions[i].xy),positions[i].z):vec4(positions[i].xyz,1);
    vec4 sampleValue=mix(vec4(0,0,0,1),textureLod(fogVolume,coordinates.xyz,0),coordinates.w);
    AzureFogTransport fog=azureFogVolumeTransport(sampleValue);
    results[i*4]=sampleValue;
    results[i*4+1]=vec4(azureApplyFogTransport(fog,vec3(1,2,3),1),1);
    results[i*4+2]=vec4(azureApplyFogTransport(fog,vec3(1,2,3),0),1);
    results[i*4+3]=coordinates;
}

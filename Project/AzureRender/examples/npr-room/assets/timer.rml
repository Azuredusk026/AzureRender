<rml>
<head>
<title>Timer</title>
<style>
body { width: 100%; height: 100%; margin: 0; color: white; font-family: LatoLatin; }
#timer { position: absolute; right: 16dp; top: 16dp; padding: 10dp 14dp; background-color: #19232c; }
#timer-value { display: block; font-size: 26dp; }
#timer-phase { display: block; font-size: 16dp; }
#timer-settings { display: block; font-size: 14dp; }
#timer-controls { display: block; margin-top: 8dp; font-size: 13dp; }
#timer-controls button { display: inline-block; padding: 4dp 7dp; margin-right: 3dp; color: white; background-color: #34434f; }
#timer-controls button:hover { background-color: #506472; }
#work-stats { display: block; margin-top: 8dp; font-size: 13dp; }
#work-calendar { margin-top: 8dp; }
#calendar-month { display: block; font-size: 15dp; }
.calendar-row { display: block; height: 18dp; }
.calendar-row span { display: inline-block; width: 32dp; height: 18dp; text-align: center; }
#calendar-picker button { display: inline-block; padding: 3dp; margin-right: 2dp; color: white; background-color: #34434f; }
#calendar-picker button:hover { background-color: #506472; }
#calendar-status { display: block; color: #f0c58e; }
#notes-toggle { position: absolute; left: 16dp; top: 16dp; padding: 6dp 10dp; color: white; background-color: #34434f; }
#notes-panel { position: absolute; left: 16dp; top: 52dp; width: 310dp; padding: 14dp; background-color: #19232c; }
#notes-panel button { display: inline-block; padding: 4dp 6dp; margin-right: 4dp; margin-bottom: 7dp; color: white; background-color: #34434f; }
#notes-panel input, #notes-panel textarea { display: block; width: 290dp; padding: 5dp; margin-bottom: 8dp; color: white; background-color: #273541; }
#notes-panel textarea { height: 135dp; }
#note-page { display: block; margin-bottom: 6dp; }
#note-status { display: block; color: #f0c58e; }
#todo-toggle { position: absolute; left: 82dp; top: 16dp; padding: 6dp 10dp; color: white; background-color: #34434f; }
#todo-panel { position: absolute; right: 16dp; top: 168dp; width: 316dp; max-height: 70%; overflow-y: auto; padding: 12dp; background-color: #19232c; }
#todo-panel button { display: inline-block; padding: 4dp 6dp; margin-right: 3dp; margin-bottom: 6dp; color: white; background-color: #34434f; }
#todo-panel input { display: block; width: 288dp; padding: 4dp; margin-bottom: 6dp; color: white; background-color: #273541; }
.todo-caption { display: block; margin-bottom: 4dp; }
#todo-status { display: block; color: #f0c58e; }
</style>
</head>
<body>
<div id="timer">
<span id="timer-value">25:00</span>
<span id="timer-phase">idle</span>
<span id="timer-settings">25m work · 5m break · 2 rounds</span>
<div id="timer-controls">
<button id="timer-mode-button" data-action="timer-mode">Mode · M</button>
<button id="timer-toggle-button" data-action="timer-toggle">Start/Pause · T</button>
<button id="timer-end-button" data-action="timer-reset">End · R</button>
<button id="timer-stats" data-action="timer-stats" style="display: none;">Statistics</button>
</div>
<div id="work-stats" style="display: none;">Today <span id="work-today"></span> · Total <span id="work-total"></span>
<span id="work-progression" style="display: none;"></span>
<div id="work-calendar">
<span id="calendar-month"></span>
<div class="calendar-row"><span id="calendar-weekday-1"></span><span id="calendar-weekday-2"></span><span id="calendar-weekday-3"></span><span id="calendar-weekday-4"></span><span id="calendar-weekday-5"></span><span id="calendar-weekday-6"></span><span id="calendar-weekday-7"></span></div>
<div class="calendar-row"><span id="calendar-date-1"></span><span id="calendar-date-2"></span><span id="calendar-date-3"></span><span id="calendar-date-4"></span><span id="calendar-date-5"></span><span id="calendar-date-6"></span><span id="calendar-date-7"></span></div>
<div class="calendar-row"><span id="calendar-date-8"></span><span id="calendar-date-9"></span><span id="calendar-date-10"></span><span id="calendar-date-11"></span><span id="calendar-date-12"></span><span id="calendar-date-13"></span><span id="calendar-date-14"></span></div>
<div class="calendar-row"><span id="calendar-date-15"></span><span id="calendar-date-16"></span><span id="calendar-date-17"></span><span id="calendar-date-18"></span><span id="calendar-date-19"></span><span id="calendar-date-20"></span><span id="calendar-date-21"></span></div>
<div class="calendar-row"><span id="calendar-date-22"></span><span id="calendar-date-23"></span><span id="calendar-date-24"></span><span id="calendar-date-25"></span><span id="calendar-date-26"></span><span id="calendar-date-27"></span><span id="calendar-date-28"></span></div>
<div class="calendar-row"><span id="calendar-date-29"></span><span id="calendar-date-30"></span><span id="calendar-date-31"></span><span id="calendar-date-32"></span><span id="calendar-date-33"></span><span id="calendar-date-34"></span><span id="calendar-date-35"></span></div>
<div class="calendar-row"><span id="calendar-date-36"></span><span id="calendar-date-37"></span><span id="calendar-date-38"></span><span id="calendar-date-39"></span><span id="calendar-date-40"></span><span id="calendar-date-41"></span><span id="calendar-date-42"></span></div>
<div>Start of week <span id="calendar-first-day"></span></div>
<div id="calendar-picker">
<button id="calendar-first-0" data-action="calendar-first-0">Sun</button>
<button id="calendar-first-1" data-action="calendar-first-1">Mon</button>
<button id="calendar-first-2" data-action="calendar-first-2">Tue</button>
<button id="calendar-first-3" data-action="calendar-first-3">Wed</button>
<button id="calendar-first-4" data-action="calendar-first-4">Thu</button>
<button id="calendar-first-5" data-action="calendar-first-5">Fri</button>
<button id="calendar-first-6" data-action="calendar-first-6">Sat</button>
</div>
<span id="calendar-status"></span>
</div>
</div>
</div>
<button id="notes-toggle" data-action="notes-toggle" style="display: none;">Notes</button>
<div id="notes-panel" style="display: none;">
<span id="note-page"></span>
<button id="note-prev" data-action="notes-prev">Previous</button>
<button id="note-next" data-action="notes-next">Next</button>
<button id="note-new" data-action="notes-new">New Page</button>
<div id="note-fields">
<input id="note-title" value="" />
<textarea id="note-text"></textarea>
<button id="note-save" data-action="notes-save">Save</button>
<button id="note-up" data-action="notes-up">Move up</button>
<button id="note-down" data-action="notes-down">Move down</button>
<button id="note-delete" data-action="notes-delete">Delete</button>
</div>
<span id="note-status"></span>
</div>
<button id="todo-toggle" data-action="todo-toggle" style="display: none;">Tasks</button>
<div id="todo-panel" style="display: none;">
<span class="todo-caption">List <span id="todo-list-position"></span></span>
<input id="todo-list-title" placeholder="List title" />
<button id="todo-list-prev" data-action="todo-list-prev">Previous list</button>
<button id="todo-list-next" data-action="todo-list-next">Next list</button>
<button id="todo-list-new" data-action="todo-list-new">New list</button>
<button id="todo-list-delete" data-action="todo-list-delete">Delete list</button>
<span class="todo-caption">Completed <span id="todo-progress"></span></span>
<button id="todo-task-new" data-action="todo-task-new">Add task</button>
<button id="todo-save" data-action="todo-save">Save</button>
<div id="todo-task-details">
<span class="todo-caption">Task <span id="todo-task-position"></span> · <span id="todo-task-state"></span></span>
<input id="todo-task-text" placeholder="Task name" />
<input id="todo-task-due" placeholder="Due date YYYY-MM-DD" />
<button id="todo-task-prev" data-action="todo-task-prev">Previous</button>
<button id="todo-task-next" data-action="todo-task-next">Next</button>
<button id="todo-task-complete" data-action="todo-task-complete">Complete</button>
<button id="todo-task-up" data-action="todo-task-up">Up</button>
<button id="todo-task-down" data-action="todo-task-down">Down</button>
<button id="todo-task-delete" data-action="todo-task-delete">Delete</button>
</div>
<span id="todo-status"></span>
</div>
</body>
</rml>

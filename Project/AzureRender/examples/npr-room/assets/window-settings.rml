<style>
#display-toggle { position: absolute; left: 16dp; bottom: 16dp; padding: 6dp 10dp; color: white; background-color: #34434f; }
#display-panel { position: absolute; left: 16dp; bottom: 52dp; width: 268dp; padding: 12dp; background-color: #19232c; }
.display-row { display: block; padding: 4dp 0; min-height: 28dp; }
.display-row button { float: right; min-width: 104dp; text-align: left; padding: 4dp 8dp; color: white; background-color: #34434f; }
.display-row button:hover, .display-row button:focus, #display-toggle:focus { background-color: #506472; }
#display-status { display: block; color: #f0c58e; }
</style>
<button id="display-toggle" data-action="display-toggle" style="display: none;">Display</button>
<div id="display-panel" style="display: none;">
  <div class="display-row">Window mode <button id="display-mode" data-action="display-mode">Windowed</button></div>
  <div class="display-row" id="display-resolution-row">Resolution <button id="display-resolution" data-action="display-resolution">Custom</button></div>
  <div class="display-row">Always on top <button id="display-topmost" data-action="display-topmost">Off</button></div>
  <span id="display-status"></span>
</div>

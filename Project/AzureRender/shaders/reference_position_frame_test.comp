#version 450
#extension GL_GOOGLE_include_directive : require
#include "reference_position_frame.glsl"
layout(local_size_x=64) in;
struct Input {vec4 position;vec4 expected;};
layout(std430,binding=0) readonly buffer Inputs {Input values[];} source;
layout(std430,binding=1) writeonly buffer Outputs {vec4 values[];} destination;
layout(push_constant) uniform Frame {uvec4 code;vec4 offset;} parameters;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=source.values.length())return;
    destination.values[i]=vec4(azureReferenceRelativePosition(source.values[i].position.xyz,parameters.code.x,parameters.offset.xyz),1);
}

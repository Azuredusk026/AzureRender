#version 450
#extension GL_GOOGLE_include_directive : require
#include "reflection_surface.glsl"
layout(local_size_x=1) in;
layout(std430,binding=0) readonly buffer Inputs {vec4 values[];} source;
layout(std430,binding=1) writeonly buffer Outputs {vec4 values[];} result;
void main(){
    uint i=gl_GlobalInvocationID.x;
    vec4 packed=encodeReflectionSurface(123.5+float(i),source.values[i].xyz,source.values[i].w);
    result.values[i*2]=packed;
    result.values[i*2+1]=vec4(decodeReflectionSurfaceNormal(packed),packed.a);
}

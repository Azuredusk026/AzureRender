#version 450
#extension GL_GOOGLE_include_directive : require
#include "octahedral_environment.glsl"
layout(local_size_x=1) in;
layout(binding=0) uniform sampler2DArray environmentArray;
struct Query {vec4 directionLod;vec4 layerUvMode;};
layout(std430,binding=1) readonly buffer Queries {Query queries[];};
layout(std430,binding=2) writeonly buffer Results {vec4 results[];};
layout(push_constant) uniform Sampling {vec4 atlas;vec4 properties;} sampling;
void main(){
    uint i=gl_GlobalInvocationID.x;Query q=queries[i];
    vec2 uv=q.layerUvMode.w>.5?q.layerUvMode.yz:octahedralEnvironmentUv(q.directionLod.xyz,sampling.atlas,sampling.properties.x>.5);
    results[i*2]=vec4(textureLod(environmentArray,vec3(uv,q.layerUvMode.x),q.directionLod.w).rgb,1);
    results[i*2+1]=vec4(uv,q.directionLod.w,q.layerUvMode.x);
}

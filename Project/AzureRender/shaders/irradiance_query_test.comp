#version 450
#extension GL_GOOGLE_include_directive : require
#include "irradiance_query.glsl"
layout(local_size_x=1) in;
layout(std430,binding=0) readonly buffer Inputs {vec4 inputs[];};
layout(std430,binding=1) writeonly buffer Results {vec4 results[];};
void main(){
    uint i=gl_GlobalInvocationID.x;vec4 p=inputs[i*3],n=inputs[i*3+1],sampleInput=inputs[i*3+2];
    results[i]=vec4(irradianceQueryPosition(p.xyz,n.xyz,sampleInput.xy,vec3(p.w,n.w,sampleInput.z)),
        irradianceQuerySignedNoise(sampleInput.xy,sampleInput.z));
}

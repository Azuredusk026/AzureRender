#version 450
#extension GL_GOOGLE_include_directive : require
#include "irradiance_query.glsl"
layout(local_size_x=1) in;
layout(std430,binding=0) readonly buffer Inputs {vec4 inputs[];};
layout(std430,binding=1) writeonly buffer Results {vec4 results[];};
void main(){
    uint i=gl_GlobalInvocationID.x;vec4 p=inputs[i*7],n=inputs[i*7+1],sampleInput=inputs[i*7+2];
    uint flags=uint(sampleInput.w);
    vec2 pixel=irradianceQueryPixel(sampleInput.xy,inputs[i*7+6].x,flags);
    vec3 direction=(flags&4u)!=0u?inputs[i*7+3].xyz+inputs[i*7+4].xyz+inputs[i*7+5].xyz:vec3(1);
    results[i]=vec4(irradianceQueryPosition(p.xyz,n.xyz,pixel,vec3(p.w,n.w,sampleInput.z),direction),
        irradianceQuerySignedNoise(pixel,sampleInput.z));
}

#version 450
layout(local_size_x=64) in;
layout(binding=0) uniform sampler2D originalImage;
layout(binding=1) uniform sampler2D compactImage;
layout(std430,binding=2) buffer Results {uvec4 mismatches[];};
void main(){
    uint i=gl_GlobalInvocationID.x;
    vec2 uv=vec2(float(i%67u)/19.0-1.0,float((i*31u)%71u)/23.0-1.0);
    float lod=float(i%17u)*.25-1.0;
    vec4 a,b;
    if((i&1u)==0u){a=textureLod(originalImage,uv,lod);b=textureLod(compactImage,uv,lod);}
    else {
        vec2 dx=vec2(float(1u+i%11u)*.017,.003),dy=vec2(-.001,float(1u+i%7u)*.013);
        a=textureGrad(originalImage,uv,dx,dy);b=textureGrad(compactImage,uv,dx,dy);
    }
    mismatches[i]=uvec4(notEqual(floatBitsToUint(a),floatBitsToUint(b)));
}

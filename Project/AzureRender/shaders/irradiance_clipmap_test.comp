#version 450
#extension GL_GOOGLE_include_directive : require
#include "irradiance_clipmap.glsl"
layout(local_size_x=1) in;
layout(binding=0) uniform sampler3D volumes[6];
layout(std430,binding=1) readonly buffer Parameters {vec4 parameters[13];};
layout(std430,binding=2) readonly buffer Positions {vec4 positions[];};
layout(std430,binding=3) writeonly buffer Results {vec4 results[];};
void main(){
    uint i=gl_GlobalInvocationID.x;
    IrradianceClipmapResult value=evaluateIrradianceClipmap(volumes,parameters,positions[i].xyz);
    for(uint c=0;c<3;++c){results[i*6+c]=value.coefficients[c];results[i*6+3+c]=vec4(value.alpha[c],0);}
}

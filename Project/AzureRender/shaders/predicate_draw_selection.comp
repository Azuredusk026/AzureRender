#version 450
layout(local_size_x=64) in;
struct Draw {uint indexCount;uint instanceCount;uint firstIndex;int vertexOffset;uint firstInstance;};
layout(std430,binding=0) readonly buffer Source {Draw values[];} source;
layout(std430,binding=1) readonly buffer Predicate {uint fallback;} predicate;
layout(std430,binding=2) writeonly buffer Output {Draw values[];} selected;
layout(push_constant) uniform Selection {uint count;uint capacity;uint permitted;} selection;
void main(){
    uint index=gl_GlobalInvocationID.x;if(index>=selection.count)return;
    Draw full=source.values[index],fast=full;
    if(selection.permitted!=0u&&predicate.fallback==0u)full.instanceCount=0u;
    else fast.instanceCount=0u;
    selected.values[index]=full;selected.values[selection.capacity+index]=fast;
}

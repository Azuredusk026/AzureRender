#version 450
#extension GL_GOOGLE_include_directive : require
#include "motion_projection.glsl"
layout(local_size_x=1) in;
layout(std430,binding=0) readonly buffer Input {vec4 values[];} source;
layout(std430,binding=1) buffer Output {vec4 values[];} result;
void main(){uint i=gl_GlobalInvocationID.x;
    result.values[i]=azureMotionProjection(source.values[i*3u],source.values[i*3u+1u],source.values[i*3u+2u].x>0);}

#version 450
#extension GL_GOOGLE_include_directive : require
#include "sky.glsl"
#include "light_attenuation.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(std140,binding=0) uniform Params {vec4 origin,right,up,forward,skyColor,sky;uvec4 counts,image;} p;
struct Triangle{vec4 p0,e1,e2,uv01,uv2material,n0,n1,n2,t0,t1,t2;};
struct Node{vec4 minimum,maximum;uvec4 links;};
struct Material{uvec4 albedo,surface,emission,normal,transmissionMap;vec4 properties,transmission,attenuation;};
struct Light{vec4 position,radiance,directionOuter,coneType;vec4 boxRows[3];vec4 boxParameters;};
layout(std430,binding=1) readonly buffer Triangles{Triangle triangles[];};
layout(std430,binding=2) readonly buffer Nodes{Node nodes[];};
layout(std430,binding=3) readonly buffer Materials{Material materials[];};
layout(std430,binding=4) readonly buffer Pixels{uint pixels[];};
layout(std430,binding=5) buffer History{vec4 history[];};
layout(std430,binding=6) readonly buffer Lights{Light lights[];};
layout(binding=7) uniform sampler2D environmentTexture;
layout(std430,binding=8) buffer Guides{vec4 guides[];};
const float PI=3.14159265359;
uint rng;
float random(){rng=rng*747796405u+2891336453u;uint word=((rng>>((rng>>28u)+4u))^rng)*277803737u;return float((word>>22u)^word)/4294967296.0;}
vec4 texel(uvec4 image,vec2 uv){
 uvec2 xy=uvec2(fract(uv)*vec2(image.yz));uint value=pixels[image.x+xy.y*image.y+xy.x];
 vec4 c=vec4(value&255u,(value>>8)&255u,(value>>16)&255u,value>>24)/255.0;
 if(image.w!=0u)c.rgb=mix(c.rgb/12.92,pow((c.rgb+.055)/1.055,vec3(2.4)),step(vec3(.04045),c.rgb));return c;
}
bool boxHit(Node n,vec3 origin,vec3 direction,float limit){
 float nearT=0,farT=limit;
 for(int axis=0;axis<3;++axis){
  if(abs(direction[axis])<1e-12){if(origin[axis]<n.minimum[axis]||origin[axis]>n.maximum[axis])return false;}
  else{float a=(n.minimum[axis]-origin[axis])/direction[axis],b=(n.maximum[axis]-origin[axis])/direction[axis];nearT=max(nearT,min(a,b));farT=min(farT,max(a,b));}
 }return farT>=nearT;
}
bool intersect(vec3 origin,vec3 direction,inout float distance,out uint triangle,out vec2 uv,out vec2 bary){
 if(p.counts.y==0u)return false;
 uint stack[64];uint top=1u;stack[0]=0u;bool hit=false;
 while(top>0u){Node n=nodes[stack[--top]];if(!boxHit(n,origin,direction,distance))continue;
  if(n.links.y==0u){stack[top++]=n.links.x;stack[top++]=n.links.z;continue;}
  for(uint k=0u;k<n.links.y;++k){uint id=n.links.x+k;Triangle t=triangles[id];vec3 q=cross(direction,t.e2.xyz);float determinant=dot(t.e1.xyz,q);if(abs(determinant)<1e-9)continue;
   Material m=materials[uint(t.uv2material.z)];if(m.properties.w<.5&&m.transmission.x<=0&&determinant<0)continue;
   vec3 s=origin-t.p0.xyz;float u=dot(s,q)/determinant;if(u<0||u>1)continue;
   vec3 r=cross(s,t.e1.xyz);float v=dot(direction,r)/determinant;if(v<0||u+v>1)continue;
   float d=dot(t.e2.xyz,r)/determinant;if(d<.0001||d>=distance)continue;
   vec2 coord=t.uv01.xy*(1-u-v)+t.uv01.zw*u+t.uv2material.xy*v;float alpha=texel(m.albedo,coord).a;
   if(m.properties.y>.5&&m.properties.y<1.5&&alpha<m.properties.z)continue;
   if(m.properties.y>1.5&&random()>alpha)continue;
   distance=d;triangle=id;uv=coord;bary=vec2(u,v);hit=true;
  }
 }return hit;
}
vec3 sky(vec3 direction){
 float a=p.sky.z;direction.xz=mat2(cos(a),sin(a),-sin(a),cos(a))*direction.xz;
 if(p.sky.x>1.5)return p.skyColor.rgb*p.sky.y;
 if(p.sky.x>.5)return textureLod(environmentTexture,vec2(atan(direction.z,direction.x)/ (2*PI)+.5,acos(clamp(direction.y,-1,1))/PI),0).rgb*p.sky.y;
 return azureProceduralSky(direction)*p.sky.y;
}
vec3 hemisphere(vec3 n){float r=sqrt(random()),a=2*PI*random();vec3 tangent=normalize(cross(abs(n.y)<.99?vec3(0,1,0):vec3(1,0,0),n));return tangent*(r*cos(a))+cross(n,tangent)*(r*sin(a))+n*sqrt(max(0,1-r*r));}
#include "pathtracing/bsdf.glsl"
#include "pathtracing/lighting.glsl"
vec3 trace(vec3 origin,vec3 direction){
 vec3 result=vec3(0),throughput=vec3(1),previous=origin;float previousPdf=0;bool previousDelta=true;vec3 absorption=vec3(0);
 for(uint bounce=0;bounce<p.counts.w;++bounce){
  float distance=bounce==0?p.up.w:1e30;uint index;vec2 uv,bary;
  if(!intersect(origin,direction,distance,index,uv,bary)){result+=throughput*sky(direction)*(previousDelta?1:powerWeight(previousPdf,environmentPdf(direction)));break;}
  Triangle t=triangles[index];Material m=materials[uint(t.uv2material.z)];
  throughput*=exp(-absorption*distance);
  vec3 ng=normalize(cross(t.e1.xyz,t.e2.xyz));vec3 n=normalize(t.n0.xyz*(1-bary.x-bary.y)+t.n1.xyz*bary.x+t.n2.xyz*bary.y);
  if(dot(n,ng)<0)n=-n;
  vec4 tangent=t.t0*(1-bary.x-bary.y)+t.t1*bary.x+t.t2*bary.y;vec3 axis=normalize(tangent.xyz-n*dot(n,tangent.xyz));
  vec3 mapped=texel(m.normal,uv).xyz*2-1;n=normalize(mat3(axis,cross(n,axis)*sign(tangent.w),n)*mapped);
  bool entering=dot(ng,direction)<0;
  if(!entering){ng=-ng;n=-n;}if(dot(n,-direction)<=0)n=ng;
  vec3 position=origin+direction*distance;vec3 albedo=texel(m.albedo,uv).rgb;vec4 surface=texel(m.surface,uv);
  materialTransmission=m.transmission.x*texel(m.transmissionMap,uv).r;materialIor=m.transmission.y;materialEta=entering?materialIor:1/materialIor;
  float emissionWeight=previousDelta?1:powerWeight(previousPdf,areaPdf(index,previous,position,direction));
  result+=throughput*texel(m.emission,uv).rgb*m.properties.x*emissionWeight;
  if(materialTransmission>.999&&abs(materialIor-1)<1e-5){previousDelta=true;previous=position;origin=position+direction*.001;continue;}
  result+=throughput*directLighting(position,ng,n,-direction,albedo,clamp(surface.b,0,1),max(.045,surface.g));
  float metal=clamp(surface.b,0,1),rough=max(.045,surface.g);vec3 v=-direction;
  direction=sampleBsdf(n,v,albedo,metal,rough);if(dot(direction,direction)<.5)break;
  float pdf=bsdfPdf(n,v,direction,albedo,metal,rough);if(pdf<=0)break;
  throughput*=evaluateBsdf(n,v,direction,albedo,metal,rough)*abs(dot(n,direction))/pdf;
  bool transmitted=dot(ng,direction)<0;
  if(transmitted){absorption=entering&&m.transmission.w>0?-log(max(m.attenuation.rgb,vec3(1e-6)))/m.transmission.w:vec3(0);}
  previousDelta=false;previousPdf=pdf;previous=position;origin=position+ng*(transmitted?-.001:.001);
  if(bounce>=2){float survival=clamp(max(max(throughput.r,throughput.g),throughput.b),.05,.95);if(random()>survival)break;throughput/=survival;}
 }return result;
}
void main(){
 uvec2 pixel=gl_GlobalInvocationID.xy;if(any(greaterThanEqual(pixel,p.image.xy)))return;
 uint index=pixel.y*p.image.x+pixel.x;rng=index*9781u+(p.image.z+1)*6271u+0x68bc21ebu+p.image.w*1013904223u;random();
 // Pixel-centre first hits provide stable scene depth and denoising guides.
 // Radiance rays keep their independent subpixel jitter.
 if(p.image.z==0u){
 guides[index]=vec4(0,0,0,-1);
 vec2 center=(vec2(pixel)+.5)/vec2(p.image.xy)*2-1;
 vec3 centerOffset=p.right.xyz*center.x-p.up.xyz*center.y;
 vec3 centerDirection=p.origin.w>.5?p.forward.xyz:normalize(p.forward.xyz+centerOffset);
 vec3 centerOrigin=p.origin.xyz+(p.origin.w>.5?centerOffset:vec3(0))+centerDirection*p.forward.w;
 float centerDistance=p.up.w;uint centerTriangle;vec2 centerUv,centerBary;
 if(intersect(centerOrigin,centerDirection,centerDistance,centerTriangle,centerUv,centerBary)){
  Triangle t=triangles[centerTriangle];guides[index]=vec4(normalize(cross(t.e1.xyz,t.e2.xyz)),centerDistance);
 }
 }
 vec2 screen=(vec2(pixel)+vec2(random(),random()))/vec2(p.image.xy)*2-1;
 vec3 offset=p.right.xyz*screen.x-p.up.xyz*screen.y;
 vec3 direction=p.origin.w>.5?p.forward.xyz:normalize(p.forward.xyz+offset);
 vec3 origin=p.origin.xyz+(p.origin.w>.5?offset:vec3(0))+direction*p.forward.w;
 vec3 color=trace(origin,direction);if(any(isnan(color))||any(isinf(color)))color=vec3(0);
 vec4 sampleColor=vec4(color,1);history[index]=p.image.z==0u?sampleColor:(history[index]*float(p.image.z)+sampleColor)/float(p.image.z+1);
}

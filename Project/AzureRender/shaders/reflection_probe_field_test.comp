#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
layout(binding=0) uniform sampler2DArray environmentArray;
struct Query { vec4 positionLod;vec4 directionLuminance;vec4 normal; };
layout(std430,binding=1) readonly buffer Queries {Query queries[];};
layout(std430,binding=2) writeonly buffer Results {vec4 results[];};
layout(std430,binding=3) readonly buffer ProbeField {vec4 probeFieldRows[];};
#include "reflection_probe_field.glsl"
void main(){uint i=gl_GlobalInvocationID.x;Query q=queries[i];results[i]=reflectionProbeFieldRadiance(environmentArray,
    q.positionLod.xyz,q.directionLuminance.xyz,q.normal.xyz,q.directionLuminance.w,q.positionLod.w);}

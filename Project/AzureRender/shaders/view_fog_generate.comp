#version 450
#extension GL_GOOGLE_include_directive : require
#define AZURE_VIEW_FOG_PARAMETER_BINDING 0
#include "view_fog_medium.glsl"

layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(rgba16f,binding=1) uniform writeonly image3D heightFogVolume;

void main(){
    ivec3 voxel=ivec3(gl_GlobalInvocationID);
    ivec3 size=imageSize(heightFogVolume);
    if(any(greaterThanEqual(voxel,size)))return;
    vec2 unitPixel=(vec2(voxel.xy)+.5)/vec2(size.xy);
    float depthFraction=float(voxel.z)/float(size.z-1);
    float depth=viewFogRows[8].z+exp2(depthFraction*azureHeightFogLogDepthRange())-1;
    vec3 origin,position;
    azureFogWorldRay(unitPixel,depth,origin,position);
    AzureFogTransport fog=azureViewHeightFog(origin,position,depth);
    imageStore(heightFogVolume,voxel,vec4(fog.scattering,fog.transmittance.x));
}

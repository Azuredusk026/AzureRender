        result.values[i]=toonIndirectChroma(ramp,toonWeight,materialClass)[channel];
    }
    else if(i<28u)result.values[i]=sceneRefractionWeight(i==24u?1.0:i==25u?.8:i==26u?.9:.999,i==27u?1.0:.8);
    else if(i<31u)result.values[i]=sceneRefractionSurface(vec3(.2),vec3(.3),vec3(.8),i==28u?.9:i==29u?1.0:.8,.8).r;
    else if(i<34u)result.values[i]=sceneRefractionUv(vec2(.5),vec2(.2),i==31u?6.0:4.0,i==33u?4.0:6.0,5.0).x;
    else if(i<36u)result.values[i]=sceneRefractionMirrorUv(vec2(i==34u?1.1:-.1)).x;
    else if(i<38u)result.values[i]=sceneRefractionOffset(vec2(.25,.75),.008)[i-36u];
    else {
#ifdef AZURE_FACE_SDF_V2
        if(i<45u) {
            vec3 light=i==38u?vec3(0,0,1):i==39u?vec3(0,0,-1):i==41u?vec3(-1,0,0):vec3(1,0,0);
            vec4 sampleValue=i==42u?vec4(.2,.8,.75,.3):i==43u?vec4(.1):i==44u?vec4(.5):vec4(.25);
            float geometryMix=i==43u?1.0:i==44u?.25:0.0;
            result.values[i]=faceSdfRampCoordinate(sampleValue,geometryMix,light,vec3(0,0,1),i==44u?-.2:.6,vec3(0));
        } else if(i<48u)result.values[i]=faceSdfSampleUv(vec2(.2,.3),i==45u?1.0:i==46u?-1.0:0.0).x;
        else if(i<51u)result.values[i]=faceSdfNormal(vec4(.2,.8,.75,.3),1.0)[i-48u];
        else result.values[i]=faceSdfRampCoordinate(vec4(.2,.8,.75,.3),0,vec3(0,1,0),vec3(0,1,0),0,vec3(0));
#else

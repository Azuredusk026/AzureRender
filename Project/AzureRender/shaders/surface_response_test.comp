        float blue=probe==6u||probe==8u?.5:probe==7u?1.0:.75;
        float side=probe==1u||probe==7u?-1.0:1.0;
        float mask=probe==3u||probe==5u||probe==8u?.5:probe==4u?1.0:0.0;
        vec3 geometry=probe==8u?-normalize(vec3(0,6.103515625e-5,1)):vec3(0,0,1);
        result.values[i]=faceSdfWorldNormal(vec4(.2,.8,blue,.3),side,frame,geometry,mask)[(i-60u)%3u];

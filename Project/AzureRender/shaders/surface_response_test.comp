layout(local_size_x=1) in;
layout(binding=0,std430) buffer Results { float values[]; } result;
layout(push_constant) uniform Parameters { float contrast; } parameters;
void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=192u) {
#ifdef AZURE_CHARACTER_SCREEN_RIM
        uint probe=(i-192u)/4u,channel=(i-192u)%4u;
        vec3 light=probe==3u?vec3(0,0,1):vec3(.8,0,.6);
        vec3 radial=probe==4u?vec3(-1,0,0):vec3(1,0,0);
        float depth=probe==1u?3.15:probe==2u?3.05:4.0;
        vec3 response=characterScreenRimResponse(vec3(.3,.1,.05),.8,vec3(1,0,0),light,vec3(0,0,1),radial,depth,3.0);
        result.values[i]=channel==3u?1.0:response[channel];
#else
        result.values[i]=-99.0;
#endif
        return;
    }
    if(i>=172u) {
#ifdef AZURE_LINE_LIGHT_GEOMETRY
        uint probe=(i-172u)/4u,channel=(i-172u)%4u;
        vec3 incoming=probe==1u?vec3(-.00103759765625,-.095458984375,.049530029296875)
            :probe==2u?vec3(2,0,0):probe==3u?vec3(0):vec3(0,0,2);
        vec3 axis=probe==1u?vec3(-.8333109617233276,.20295734703540802,.5141994953155518):vec3(1,0,0);
        LineLightGeometry geometry=lineLightGeometry(incoming,axis,probe==1u?1.0:probe==4u?0.0:2.0);
        result.values[i]=channel==3u?geometry.factor:geometry.direction[channel];
#else
        result.values[i]=-99.0;

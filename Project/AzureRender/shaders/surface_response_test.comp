        return;
    }
    if(i>=163u) {
#ifdef AZURE_CHARACTER_WEIGHTED_DIFFUSE
        // Captured visible primitive 1017: explicit material and host weights.
        CharacterDiffuseResponse response=characterDiffuseWeightedResponse(
            vec3(.56787109375,.1014404296875,.10821533203125),
            vec3(.33250007033348083,.050309497863054276,.05440831184387207),

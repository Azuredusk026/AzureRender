            .8828107118606567,.8828107118606567,1.0,1.0);
        CharacterDiffuseIllumination light=characterDiffuseIllumination(
            vec3(-.09024213999509811,.37075215578079224,.9243371486663818),
            vec3(.8783068656921387,.9302293062210083,1.1216931343078613),

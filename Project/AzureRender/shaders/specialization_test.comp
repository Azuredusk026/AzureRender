#version 450
#extension GL_GOOGLE_include_directive : require
#include "material_specialization.glsl"
layout(local_size_x=1) in;
layout(constant_id=0) const bool enabled=false;
layout(constant_id=7) const uint integerValue=3;
layout(constant_id=15) const float realValue=0.5;
layout(binding=0,std430) buffer Output {vec4 value;};
layout(binding=1,std430) buffer FeatureValues {uint features[];};
void main(){
    value=vec4(enabled?1:0,float(integerValue),realValue,0.25);
    for(uint i=0;i<uint(features.length());++i)features[i]=azureSpecializedMaterialFeatures(enabled,features[i]);
}

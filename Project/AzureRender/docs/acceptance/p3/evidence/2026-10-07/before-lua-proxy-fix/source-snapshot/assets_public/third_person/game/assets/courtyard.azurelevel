            "translation": [
              0,
              0,
              0
            ]
          }
        },
        "azure.character": {
          "type": "azure.character",
          "version": 3,
          "data": {
            "speed": 2,
            "centerOffset": 0.9,
            "sprintMultiplier": 2.5,
            "forwardYaw": 180

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D bloomLevel0;
layout(set = 0, binding = 1) uniform sampler2D bloomLevel1;
layout(set = 0, binding = 2) uniform sampler2D bloomLevel2;
layout(set = 0, binding = 3) uniform sampler2D bloomLevel3;
layout(set = 0, binding = 4, rgba16f) writeonly uniform image2D bloomOutput;

void main() {
    ivec2 size = imageSize(bloomOutput);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec3 bloom = texture(bloomLevel0, uv).rgb * 0.58
        + texture(bloomLevel1, uv).rgb * 0.27
        + texture(bloomLevel2, uv).rgb * 0.12
        + texture(bloomLevel3, uv).rgb * 0.06;
    imageStore(bloomOutput, pixel, vec4(bloom, 1.0));
}

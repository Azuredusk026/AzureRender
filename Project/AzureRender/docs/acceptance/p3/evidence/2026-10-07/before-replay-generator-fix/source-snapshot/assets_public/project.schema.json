{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azure project version 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "mounts",
    "startupScene"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "not": {
              "const": "engine"
            }
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "startupScene": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:/[^:]+$"
    }
  }
}

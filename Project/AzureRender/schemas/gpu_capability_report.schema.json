{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azurerender.local/schema/gpu-capability-report-v2.json",
  "title": "AzureRender GPU Capability Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_name",
    "vendor_id",
    "device_id",
    "api_version",
    "driver_version",
    "features",
    "compute",
    "descriptor_indexing",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "device_name": {
      "type": "string",
      "minLength": 1
    },
    "vendor_id": {
      "type": "integer",
      "minimum": 0
    },
    "device_id": {
      "type": "integer",
      "minimum": 0
    },
    "api_version": {
      "type": "integer",
      "minimum": 0
    },
    "driver_version": {
      "type": "integer",
      "minimum": 0
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampler_anisotropy", "shader_int64"],
      "properties": {
        "sampler_anisotropy": {
          "type": "boolean"
        },
        "shader_int64": {
          "type": "boolean"
        }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shader", "storage_image_write_without_format"],
      "properties": {
        "shader": {"type": "boolean"},
        "storage_image_write_without_format": {"type": "boolean"}
      }
    },
    "descriptor_indexing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_descriptor_array",
        "shader_sampled_image_array_non_uniform_indexing",
        "descriptor_binding_partially_bound",
        "descriptor_binding_variable_descriptor_count"
      ],
      "properties": {
        "runtime_descriptor_array": {
          "type": "boolean"
        },
        "shader_sampled_image_array_non_uniform_indexing": {
          "type": "boolean"
        },
        "descriptor_binding_partially_bound": {
          "type": "boolean"
        },
        "descriptor_binding_variable_descriptor_count": {
          "type": "boolean"
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

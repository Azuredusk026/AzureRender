{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azurerender.local/schema/gpu-capability-report-v3.json",
  "title": "AzureRender GPU Capability Report v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_name",
    "vendor_id",
    "device_id",
    "api_version",
    "driver_version",
    "features",
    "compute",
    "descriptor_indexing",
    "resource_access",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "device_name": {
      "type": "string",
      "minLength": 1
    },
    "vendor_id": {
      "type": "integer",
      "minimum": 0
    },
    "device_id": {
      "type": "integer",
      "minimum": 0
    },
    "api_version": {
      "type": "integer",
      "minimum": 0
    },
    "driver_version": {
      "type": "integer",
      "minimum": 0
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampler_anisotropy",
        "shader_int64"
      ],
      "properties": {
        "sampler_anisotropy": {
          "type": "boolean"
        },
        "shader_int64": {
          "type": "boolean"
        }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shader",
        "storage_image_write_without_format"
      ],
      "properties": {
        "shader": {
          "type": "boolean"
        },
        "storage_image_write_without_format": {
          "type": "boolean"
        }
      }
    },
    "descriptor_indexing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_descriptor_array",
        "shader_sampled_image_array_non_uniform_indexing",
        "descriptor_binding_partially_bound",
        "descriptor_binding_variable_descriptor_count"
      ],
      "properties": {
        "runtime_descriptor_array": {
          "type": "boolean"
        },
        "shader_sampled_image_array_non_uniform_indexing": {
          "type": "boolean"
        },
        "descriptor_binding_partially_bound": {
          "type": "boolean"
        },
        "descriptor_binding_variable_descriptor_count": {
          "type": "boolean"
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "enabled",
        "limits"
      ],
      "properties": {
        "supported": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device_address",
            "sampled_image_update_after_bind"
          ],
          "properties": {
            "device_address": {
              "type": "boolean"
            },
            "sampled_image_update_after_bind": {
              "type": "boolean"
            }
          }
        },
        "enabled": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "descriptor_indexing",
            "device_address",
            "allocator_device_address",
            "update_after_bind"
          ],
          "properties": {
            "descriptor_indexing": {
              "type": "boolean"
            },
            "device_address": {
              "type": "boolean"
            },
            "allocator_device_address": {
              "type": "boolean"
            },
            "update_after_bind": {
              "type": "boolean"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_per_stage_descriptor_samplers",
            "max_descriptor_set_samplers",
            "max_per_stage_descriptor_sampled_images",
            "max_descriptor_set_sampled_images",
            "max_per_stage_resources",
            "max_per_stage_update_after_bind_samplers",
            "max_set_update_after_bind_samplers",
            "max_per_stage_update_after_bind_sampled_images",
            "max_set_update_after_bind_sampled_images",
            "max_per_stage_update_after_bind_resources",
            "max_update_after_bind_descriptors_all_pools"
          ],
          "properties": {
            "max_per_stage_descriptor_samplers": {
              "type": "integer",
              "minimum": 0
            },
            "max_descriptor_set_samplers": {
              "type": "integer",
              "minimum": 0
            },
            "max_per_stage_descriptor_sampled_images": {
              "type": "integer",
              "minimum": 0
            },
            "max_descriptor_set_sampled_images": {
              "type": "integer",
              "minimum": 0
            },
            "max_per_stage_resources": {
              "type": "integer",
              "minimum": 0
            },
            "max_per_stage_update_after_bind_samplers": {
              "type": "integer",
              "minimum": 0
            },
            "max_set_update_after_bind_samplers": {
              "type": "integer",
              "minimum": 0
            },
            "max_per_stage_update_after_bind_sampled_images": {
              "type": "integer",
              "minimum": 0
            },
            "max_set_update_after_bind_sampled_images": {
              "type": "integer",
              "minimum": 0
            },
            "max_per_stage_update_after_bind_resources": {
              "type": "integer",
              "minimum": 0
            },
            "max_update_after_bind_descriptors_all_pools": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}

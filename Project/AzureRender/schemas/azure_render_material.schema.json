{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azurerender.local/schema/material-profile-v1.json",
  "title": "AzureRender glTF Material Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "class",
    "features",
    "styleParameters",
    "featureParameters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "class": {
      "enum": [
        "generic",
        "skin",
        "face",
        "hair",
        "fabric",
        "metal",
        "eye",
        "overlay",
        "emissive",
        "showcase"
      ]
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "stylized-shadow",
          "hair-anisotropy",
          "face-sdf-eligible",
          "emissive-mask",
          "overlay",
          "neutral-fallback",
          "brow-overlay"
        ]
      }
    },
    "styleParameters": {
      "description": "Class-dependent style vector. Lit materials use toon/shadow/specular/rim; brow-overlay uses local vertical lift, Face-D ink expansion radius in texels and two reserved values.",
      "$ref": "#/$defs/parameterVector"
    },
    "featureParameters": {
      "description": "Class-dependent feature vector. Brow-overlay uses view offset, opacity, fade distance and base power.",
      "$ref": "#/$defs/parameterVector"
    },
    "faceSdf": {
      "$ref": "#/$defs/faceSdfProfile"
    }
  },
  "$defs": {
    "parameterVector": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 4.0
      }
    },
    "faceSdfProfile": {
      "description": "Face SDF texture and head-local orientation contract.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "texture",
        "texCoord",
        "channel",
        "maskChannel",
        "shadowOnLowValues",
        "horizontalAxis",
        "headNode"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "texture": {
          "type": "integer",
          "minimum": 0
        },
        "texCoord": {
          "const": 0
        },
        "channel": {
          "enum": ["r", "g", "b", "a"]
        },
        "maskChannel": {
          "enum": ["r", "g", "b", "a"]
        },
        "shadowOnLowValues": {
          "type": "boolean"
        },
        "horizontalAxis": {
          "description": "Which face side is stored at increasing U.",
          "enum": ["left-to-right", "right-to-left"]
        },
        "headNode": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azurerender.local/schema/material-profile-v1.json",
  "title": "AzureRender glTF Material Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "class",
    "features",
    "styleParameters",
    "featureParameters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "class": {
      "enum": [
        "generic",
        "skin",
        "face",
        "hair",
        "fabric",
        "metal",
        "eye",
        "overlay",
        "emissive",
        "showcase"
      ]
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "stylized-shadow",
          "hair-anisotropy",
          "face-sdf-eligible",
          "emissive-mask",
          "overlay",
          "neutral-fallback"
        ]
      }
    },
    "styleParameters": {
      "description": "toon, shadow tint, specular, rim",
      "$ref": "#/$defs/parameterVector"
    },
    "featureParameters": {
      "description": "outline, hair highlight, emissive, face overlay",
      "$ref": "#/$defs/parameterVector"
    }
  },
  "$defs": {
    "parameterVector": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 4.0
      }
    }
  }
}
